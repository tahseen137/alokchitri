    "manual_body": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোনে ISO বা শাটার নিজে ঠিক করা যায় না। Auto বা নাইট মোড ব্যবহার করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone doesn't let you set ISO or shutter yourself. Use Auto or Night mode."
          }
        }
      }
    },
    "manual_have_pro": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমার ক্যামেরায় Pro মোড আছে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My camera does have Pro mode"
          }
        }
      }
    },
    "manual_home": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হোমে ফিরে যান"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to home"
          }
        }
      }
    },
    "manual_tip_night": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আলো কম হলে ক্যামেরার “Night” মোড ব্যবহার করুন, আর ছবি ওঠা শেষ না হওয়া পর্যন্ত ফোন স্থির রাখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In low light, use your camera's “Night” mode and keep the phone still until the photo is done."
          }
        }
      }
    },
    "manual_tip_steady": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কনুই শরীরে চেপে ধরুন বা দেয়ালে ঠেস দিন। জানালার আলো মুখের দিকে রাখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brace your elbows against your body or lean on a wall. Face window light towards your subject."
          }
        }
      }
    },
    "manual_tip_tap": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিষয়ের ওপর আঙুল দিয়ে ট্যাপ করুন, ফোকাস ও আলো সেখানে মিলবে। পাশে সূর্যের চিহ্ন দেখালে ওপরে-নিচে টেনে উজ্জ্বলতা ঠিক করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap your subject to set focus and brightness there. If a sun icon appears, slide it up or down to adjust brightness."
          }
        }
      }
    },
    "manual_tips_title": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তবু যা করলে ছবি ভালো হবে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What still helps"
          }
        }
      }
    },
    "manual_title": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফোন ম্যানুয়াল সেটিং দেয় না"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone doesn't allow manual settings"
          }
        }
      }
    },
    "meter_bright_end": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উজ্জ্বল রোদ"
          }
