    "feedback_ai": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ফিডব্যাক"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI feedback"
          }
        }
      }
    },
    "feedback_error": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তর আনা গেল না। ইন্টারনেট দেখে আবার চেষ্টা করুন। এতে আপনার ফ্রি ফিডব্যাক কাটা হয়নি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't get feedback. Check your internet and try again. This didn't use a free feedback."
          }
        }
      }
    },
    "feedback_exif": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবির সেটিং, যা ফোন সেভ করেছে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings your phone saved with the photo"
          }
        }
      }
    },
    "feedback_left_fmt": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ %1$@টি বাকি"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ left today"
          }
        }
      }
    },
    "feedback_loading": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবি দেখা হচ্ছে…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking at your photo…"
          }
        }
      }
    },
    "feedback_next": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরের বার"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next time"
          }
        }
      }
    },
    "feedback_no_ad": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মুহূর্তে কোনো বিজ্ঞাপন নেই। একটু পরে আবার চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ad is available right now. Try again in a moment."
          }
        }
      }
    },
    "feedback_no_exif": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ছবিতে সেটিং সেভ নেই। তবু ছবি দেখে পরামর্শ দেব।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo has no saved settings. We'll still comment on the picture."
          }
        }
      }
    },
    "feedback_out": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের ফ্রি ফিডব্যাক শেষ। একটি বিজ্ঞাপন দেখে আরও একটি নিন, বা টপ-আপ কিনুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's free feedback is used up. Watch an ad for one more, or buy a top-up."
          }
        }
      }
    },
    "feedback_photo": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
