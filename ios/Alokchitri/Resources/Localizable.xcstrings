    "pro_hold_still": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro সেটিং দেওয়া হয়েছে। শাটার চাপার পর ছবি ওঠা পর্যন্ত ফোন স্থির রাখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro settings applied. After you press the shutter, keep the phone still until the photo is done."
          }
        }
      }
    },
    "pro_photos_denied": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবি সেভ করতে ফটোজে যোগ করার অনুমতি লাগবে। সেটিংসে গিয়ে অনুমতি দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To save the photo we need permission to add to Photos. Allow it in Settings."
