    "home_tip_body": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জানালার পাশে দাঁড়ালে আলো নরম আসে। ISO কম রাখুন, ছবি পরিষ্কার হবে।"
          }
