    "pro_auto_exposure": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোন অন্য অ্যাপকে ISO আর শাটার বদলাতে দেয় না। আলো ফোন নিজেই মিলাবে, বাকি সেটিং দেওয়া হয়েছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone doesn't let other apps set ISO and shutter. It will set the exposure itself; everything else is applied."
          }
        }
      }
    },
    "pro_confirm_body": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "OnePlus, OPPO-র মতো কিছু ফোন অন্য অ্যাপকে ম্যানুয়াল কন্ট্রোল দেখায় না। আপনার ক্যামেরা অ্যাপে Pro বা ম্যানুয়াল মোড থাকলে এটি চালু করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some phones, like OnePlus and OPPO, hide manual control from other apps. Turn this on if your camera app has a Pro or Manual mode."
          }
        }
      }
    },
    "pro_confirm_title": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমার ক্যামেরা অ্যাপে Pro মোড আছে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My camera app has Pro mode"
          }
        }
      }
    },
    "pro_exposure_auto": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ক্যামেরা ISO ও শাটার হাতে সেট করতে দেয় না। এক্সপোজার ক্যামেরা নিজেই ঠিক করবে, বাকি সব বসানো হয়েছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This camera doesn't allow manual ISO and shutter. It will set the exposure itself; everything else is applied."
          }
        }
      }
    },
    "pro_failed": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবি তোলা যায়নি। আবার চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't take the photo. Try again."
