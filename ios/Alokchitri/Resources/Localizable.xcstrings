    "payguide_1": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Play Store খুলে ওপরে ডানে আপনার প্রোফাইল ছবিতে চাপুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Play Store and tap your profile picture at the top right"
          }
        }
      }
    },
    "payguide_2": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“পেমেন্ট ও সাবস্ক্রিপশন” › “পেমেন্টের পদ্ধতি” খুলুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open “Payments & subscriptions” › “Payment methods”"
          }
        }
      }
    },
    "payguide_3": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তালিকায় যে উপায় আছে (যেমন বিকাশ বা মোবাইল ব্যালান্স) সেটি যোগ করুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add one of the listed options, such as bKash or mobile balance"
          }
        }
      }
    },
    "payguide_4": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গিফট কার্ডের কোড থাকলে “পেমেন্ট ও সাবস্ক্রিপশন” › “গিফট কোড রিডিম করুন”-এ কোডটি দিন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have a gift card code? Enter it in “Payments & subscriptions” › “Redeem gift code”"
          }
        }
      }
    },
    "payguide_cta": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বুঝেছি"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got it"
          }
        }
      }
    },
    "payguide_note": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এরপর এই অ্যাপে ফিরে আনলক চাপুন। পেমেন্টের সময় যোগ করা উপায়টি বেছে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then come back here and tap Unlock. Pick the method you added when paying."
          }
        }
      }
    },
    "payguide_sub": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাংক কার্ড না থাকলেও কেনা যায়। আপনার অ্যাকাউন্টে কোন উপায় আছে, Google Play নিজেই দেখায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can buy without a bank card. Google Play shows which ways to pay your account has."
          }
        }
      }
    },
    "payguide_title": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্ড ছাড়া Google Play-তে পেমেন্ট"
          }
