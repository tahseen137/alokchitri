    "meter_cam_busy": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যামেরা অন্য কোনো অ্যাপ ব্যবহার করছে। সেটা বন্ধ করে আবার চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app is using the camera. Close it and try again."
          }
        }
      }
    },
    "meter_cam_denied": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আলো মাপতে ক্যামেরার অনুমতি লাগবে। ছবি তোলা বা সেভ হয় না, শুধু আলো মাপা হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To measure light we need the camera. Nothing is photographed or saved, we only read the brightness."
          }
        }
      }
    },
    "meter_cta": {
      "extractionState": "manual",
