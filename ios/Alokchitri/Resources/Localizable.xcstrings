{
  "sourceLanguage": "bn",
  "strings": {
    "advice_auto": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রোদে Auto মোডই ভালো ছবি দেবে। ম্যানুয়ালে দেখতে চাইলে নিচের সেটিং দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto mode does well in this much light. To try manual anyway, use the settings below."
          }
        }
      }
    },
    "advice_blur": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এত কম আলোয় চলন্ত কিছু ঝাপসা হতে পারে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something moving may blur in light this low."
          }
        }
      }
    },
    "advice_night": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই আলোয় নাইট মোড হয়তো আরও ভালো ছবি দেবে। তবু ম্যানুয়ালে তুলতে চাইলে নিচের সেটিং দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Night mode may do better in this light. If you still want manual, use the settings below."
          }
        }
      }
    },
    "advice_noise": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবি পরিষ্কার রাখতে ISO বাড়াতে হয়েছে, তাই কিছুটা দানা দানা (নয়েজ) আসতে পারে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO had to go up to keep the shot sharp, so you may see some grain (noise)."
          }
        }
      }
    },
    "advice_over": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আলো এত বেশি যে ফোন এর চেয়ে দ্রুত শাটার দিতে পারে না। ছবি একটু বেশি উজ্জ্বল আসতে পারে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's brighter than your phone's fastest shutter can handle, so the photo may come out a little bright."
          }
        }
      }
    },
    "advice_under": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আলো এত কম যে সঠিক এক্সপোজার পাওয়া যাবে না। নাইট মোড বা ট্রাইপড চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's too dark for a correct exposure. Try Night mode or a tripod."
          }
        }
      }
    },
    "app_name": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আলোকচিত্রী"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alokchitri"
          }
        }
      }
    },
