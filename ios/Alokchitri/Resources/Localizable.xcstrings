    "howto_2": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“Pro” বা “প্রো” চাপুন। নিচে ISO, S, WB-র বোতাম আসবে"
