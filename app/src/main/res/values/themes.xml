<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only sets the window behind it so there is no white flash on launch. -->
    <style name="Theme.Alokchitri" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="ground">#0E1014</color>
</resources>
